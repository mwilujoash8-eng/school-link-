# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_URL: Optional external backend URL when deploying client to GitHub Pages.
VITE_API_URL=""

# VITE_THEME_BG: Global theme background color used across web and mobile viewports.
VITE_THEME_BG="#0b0f19"

# VITE_SPA_ROUTING: Enable client-side SPA routing and deep-link handling for static hosting (GitHub Pages, etc.).
VITE_SPA_ROUTING="true"

# VITE_APP_TITLE: Public application title and header branding.
VITE_APP_TITLE="SchoolLink - Digital School Operating System"

